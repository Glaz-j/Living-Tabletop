# Copy this file to .env or export the variables in your shell.
# Never commit a real API key.
LIVING_TABLETOP_API_KEY=
LIVING_TABLETOP_BASE_URL=https://kuaipao.ai/v1
LIVING_TABLETOP_MODEL=gpt-5.6-luna-openai-compact
LIVING_TABLETOP_LLM_ENABLED=false
# auto: local first, then remote; local/remote: use only that provider.
LIVING_TABLETOP_LLM_MODE=auto
LIVING_TABLETOP_LOCAL_LLM_ENABLED=true
LIVING_TABLETOP_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LIVING_TABLETOP_LOCAL_LLM_MODEL=qwen3.5:9b-q4_K_M
LIVING_TABLETOP_LOCAL_LLM_TIMEOUT=60
LIVING_TABLETOP_LOCAL_LLM_CONTEXT_WINDOW=8192
LIVING_TABLETOP_LLM_COOLDOWN=60
LIVING_TABLETOP_LLM_TIMEOUT=30
LIVING_TABLETOP_LLM_MAX_RETRIES=1
LIVING_TABLETOP_LLM_MAX_OUTPUT_TOKENS=400
LIVING_TABLETOP_DB_PATH=data/living_tabletop.db
